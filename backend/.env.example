# ============================================================================
# NKETIAH SCHOOL MANAGEMENT SYSTEM - BACKEND SECURITY CONFIGURATION (.env.example)
# ============================================================================
# IMPORTANT: Copy this file to .env and replace placeholders with real secrets.
# NEVER commit your actual .env file to Git!

NODE_ENV=development
PORT=4000
SCHOOL_NAME="NKETIAH School Management System"

# CORS Allowed Origins (comma-separated for React Web & Expo Web/Mobile)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:5173

# 1. PASSWORD PEPPER (Application-level secret stored OUTSIDE Firestore)
# Must be at least 32 characters of high-entropy random hex/base64.
PASSWORD_PEPPER=replace_with_64_char_hex_server_side_pepper_secret

# 2. AES-256-GCM ENCRYPTION KEY (Used to encrypt TOTP secrets & Database Backups)
# Must be EXACTLY 64 hexadecimal characters (32 bytes = 256 bits).
AES_256_GCM_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 3. JWT SECRETS (Access Token, Pre-2FA Token, Refresh Token Signing)
JWT_ACCESS_SECRET=replace_with_64_char_hex_jwt_access_secret
JWT_PRE_2FA_SECRET=replace_with_64_char_hex_jwt_pre_2fa_secret
ACCESS_TOKEN_EXPIRES_IN=15m
PRE_2FA_TOKEN_EXPIRES_IN=5m
REFRESH_TOKEN_TTL_DAYS=7

# 4. FIREBASE / GOOGLE CLOUD CONFIGURATION
# Mode can be:
# - "firebase" (Connects to online Google Cloud Firestore using Service Account or ADC)
# - "emulator" (Connects to local Firebase Firestore Emulator on FIRESTORE_EMULATOR_HOST)
# - "hybrid"   (Uses online Firestore if credentials provided, else safe Firestore-compatible cloud-ready engine)
FIREBASE_MODE=hybrid
FIREBASE_PROJECT_ID=nketiah-school-security
FIREBASE_STORAGE_BUCKET=nketiah-school-security.appspot.com
# Path to Firebase Admin Service Account JSON or inline JSON string:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Optional inline credentials (useful for cloud deployment like Render/Cloud Run):
FIREBASE_SERVICE_ACCOUNT_JSON=

# 5. AUTOMATED BACKUP SCHEDULE (Cron Expression)
# Default: Every 6 hours ("0 */6 * * *")
BACKUP_CRON_SCHEDULE="0 */6 * * *"
BACKUP_RETENTION_COUNT=20
