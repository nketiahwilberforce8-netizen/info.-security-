rules_version = '2';

// ============================================================================
// NKETIAH SCHOOL MANAGEMENT SYSTEM - FIRESTORE SECURITY RULES
// ============================================================================
// ARCHITECTURAL PRINCIPLE:
// All client requests (React Web & Expo Mobile) MUST go through the central
// Node.js Backend API, which uses the privileged Firebase Admin SDK.
// Direct client-side Firestore access is strictly denied (Zero-Trust Client Policy).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
